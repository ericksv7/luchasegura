// Modelo de datos de LuchaSegura.
// Es una propuesta: se ajusta cuando el equipo defina los módulos.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ATHLETE
  COACH
  PHYSIO
  ADMIN
}

enum Limitation {
  NONE
  PARTIAL
  FULL
}

enum TestPhase {
  INITIAL
  FINAL
}

enum AlertStatus {
  NEW
  REVIEWED
  IN_REVIEW
  FOLLOW_UP_PENDING
}

enum AlertEntryKind {
  START
  REOPEN
  REVIEW
}

model User {
  id                 String               @id @default(uuid())
  email              String               @unique
  passwordHash       String
  fullName           String
  role               Role
  active             Boolean              @default(true)
  passwordChangedAt  DateTime?
  sessionsRevokedAt  DateTime?
  mustChangePassword Boolean              @default(false)
  createdAt          DateTime             @default(now())
  athlete            Athlete?             @relation("AthleteProfile")
  coaching           Athlete[]            @relation("CoachAthletes")
  sleepSharing       SleepSharing[]
  consents           Consent[]
  resetTokens        PasswordResetToken[]
  assignedExercises  ExerciseAssignment[] @relation("AssignedExercises")
  alertEntries       AlertEntry[]
  evaluationRevisions FunctionalTestRevision[]
  injuryRevisions InjuryCharacterization[]
  surveyResponses PreventiveSurvey[]
  surveyRevisions PreventiveSurveyRevision[]
}

// Módulo 1: perfil del deportista
model Athlete {
  id              String    @id @default(uuid())
  userId          String    @unique
  user            User      @relation("AthleteProfile", fields: [userId], references: [id], onDelete: Cascade)
  coachId         String?
  coach           User?     @relation("CoachAthletes", fields: [coachId], references: [id], onDelete: SetNull)
  birthDate       DateTime?
  weightKg        Decimal?  @db.Decimal(5, 2)
  category        String?
  style           String?   // libre, grecorromana, femenina
  programStartedAt DateTime? @db.Date
  yearsExperience Int?
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  injuries        Injury[]
  completed       CompletedSession[]
  tests           FunctionalTest[]
  wellbeing       WellbeingEntry[]
  sleepSharing    SleepSharing?
  preventiveSurveys PreventiveSurvey[]
  surveyConsent PreventiveSurveyConsent?
    exerciseAssignments ExerciseAssignment[]

  @@index([coachId])
}

model Consent {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  textVersion  String
  textDigest   String?
  textSnapshot Json?
  acceptanceMode String?
  guardianName String?  // acudiente, si es menor de edad
  acceptedAt   DateTime @default(now())

  @@index([userId])
}

// Módulo 2: antecedentes y molestias (ficha de lesión)
model Injury {
  id          String     @id @default(uuid())
  athleteId   String
  athlete     Athlete    @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  isHistory   Boolean    @default(false) // true = antecedente, false = molestia actual
  bodyZone    String
  injuryType  String?
  intensity   Int?       // 0 a 10
  whenOccurs  String?
  mechanism   String?
  limitation  Limitation @default(NONE)
  daysAbsent  Int?
  recurrent   Boolean    @default(false)
  occurredAt  DateTime   @default(now())
  historyDate DateTime?  @db.Date
  notes       String?
  createdAt   DateTime   @default(now())
  alerts      Alert[]
  characterizations InjuryCharacterization[]

  @@index([athleteId, occurredAt])
}

model InjuryCharacterization {
  operationId String   @id
  injuryId    String
  injury      Injury   @relation(fields: [injuryId], references: [id], onDelete: Restrict)
  version     Int
  authorId    String
  author      User     @relation(fields: [authorId], references: [id], onDelete: Restrict)
  authorName  String
  recordedAt  DateTime @default(now())
  details     Json
  fingerprint String

  @@unique([injuryId, version])
  @@index([authorId])
}

model AlertRule {
  id           String   @id @default(uuid())
  bodyZone     String?  // null = aplica a todas
  minIntensity Int
  createdById  String
  createdAt    DateTime @default(now())
}

model Alert {
  id        String      @id @default(uuid())
  injuryId  String
  injury    Injury      @relation(fields: [injuryId], references: [id], onDelete: Cascade)
  status    AlertStatus @default(NEW)
  version   Int         @default(0)
  entries   AlertEntry[]
  createdAt DateTime    @default(now())

  @@index([status, createdAt])
  @@index([injuryId])
}

// Historial inmutable: revisión, inicio o reapertura, siempre con autor y estado anterior.
model AlertEntry {
  id               String         @id @default(uuid())
  alertId          String
  alert            Alert          @relation(fields: [alertId], references: [id], onDelete: NoAction)
  authorId         String
  author           User           @relation(fields: [authorId], references: [id], onDelete: NoAction)
  authorName       String
  requestId        String
  version          Int
  kind             AlertEntryKind
  previousStatus   AlertStatus
  status           AlertStatus
  observations     String
  findings         String?
  actionTaken      String?
  recommendations  String?
  followUpRequired Boolean        @default(false)
  followUpDate     DateTime?       @db.Date
  referral         String?
  createdAt        DateTime       @default(now())

  @@unique([alertId, requestId])
  @@unique([alertId, version])
  @@index([authorId])
}

// Módulo 3: programa preventivo
model Program {
  id              String           @id @default(uuid())
  name            String
  weeks           Int              @default(8)
  sessionsPerWeek Int              @default(3)
  sessions        ProgramSession[]
  evaluations     FunctionalTest[]
  preventiveSurveys PreventiveSurvey[]
  wellbeing       WellbeingEntry[]
}

model ProgramSession {
  id         String             @id @default(uuid())
  programId  String
  program    Program            @relation(fields: [programId], references: [id])
  week       Int
  number     Int
  minutes    Int?
  exercises  SessionExercise[]
  completed  CompletedSession[]

  @@unique([programId, week, number])
}

model Exercise {
  id           String               @id @default(uuid())
  component    String
  name         String
  description  String?
  dosage       String?              // repeticiones o tiempo
  zone         String?              // zona corporal principal
  mediaUrl     String?              // recurso histórico
  isBase       Boolean              @default(false)
  objective    String?
  level        String?
  equipment    String?
  instructions String?
  mistakes     String?
  precautions  String?
  illustration String?
  archived     Boolean              @default(false)
  createdAt    DateTime             @default(now())
  sessions     SessionExercise[]
  assignments  ExerciseAssignment[]

  @@index([component])
}

model ExerciseAssignment {
  id           String   @id @default(uuid())
  athleteId    String
  athlete      Athlete  @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  exerciseId   String
  exercise     Exercise @relation(fields: [exerciseId], references: [id])
  assignedById String?
  assignedBy   User?    @relation("AssignedExercises", fields: [assignedById], references: [id], onDelete: SetNull)
  dosage       String?
  note         String?
  createdAt    DateTime @default(now())

  @@unique([athleteId, exerciseId])
  @@index([athleteId])
}

model SessionExercise {
  sessionId  String
  exerciseId String
  position   Int
  session    ProgramSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  exercise   Exercise       @relation(fields: [exerciseId], references: [id])

  @@id([sessionId, exerciseId])
  @@index([exerciseId])
}

// Módulo 4: seguimiento
model CompletedSession {
  id          String         @id @default(uuid())
  athleteId   String
  athlete     Athlete        @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  sessionId   String
  session     ProgramSession @relation(fields: [sessionId], references: [id])
  doneAt      DateTime       @default(now())
  notes       String?

  @@unique([athleteId, sessionId])
}

model FunctionalTest {
  id         String    @id @default(uuid())
  athleteId  String
  athlete    Athlete   @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  testType   String    // SEBT/YBT, FMS, T-test, goniometría
  phase      TestPhase
  result     Json
  measuredAt DateTime  @default(now())
  programId  String?
  program    Program?  @relation(fields: [programId], references: [id], onDelete: Restrict)
  interventionStartedAt DateTime? @db.Date
  version    Int       @default(0)
  revisions  FunctionalTestRevision[]

  @@index([athleteId, phase])
}

model FunctionalTestRevision {
  operationId String   @id
  testId      String
  test        FunctionalTest @relation(fields: [testId], references: [id], onDelete: Cascade)
  version     Int
  authorId    String
  authorName  String
  author      User     @relation(fields: [authorId], references: [id], onDelete: Restrict)
  recordedAt  DateTime @default(now())
  measuredOn  DateTime @db.Date
  result      Json
  observations String?
  fingerprint String

  @@unique([testId, version])
  @@index([authorId])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}
model RevokedSession {
  digest    String   @id
  expiresAt DateTime

  @@index([expiresAt])
}

enum RestPerception {
  VERY_RESTFUL
  RESTFUL
  FAIR
  LITTLE_REST
  NO_REST
}

enum FatiguePerception {
  NONE
  MILD
  MODERATE
  HIGH
  VERY_HIGH
}

enum RecoveryPerception {
  VERY_GOOD
  GOOD
  FAIR
  LOW
  VERY_LOW
}

model WellbeingEntry {
  id          String   @id @default(uuid())
  athleteId   String
  athlete     Athlete  @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  programId   String
  program     Program  @relation(fields: [programId], references: [id], onDelete: Restrict)
  startedOn   DateTime @db.Date
  day         DateTime @db.Date
  week        Int
  version     Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  revisions   WellbeingRevision[]

  @@unique([athleteId, programId, day])
  @@index([athleteId, day, id])
}

model WellbeingRevision {
  operationId String             @id
  entryId     String
  entry       WellbeingEntry     @relation(fields: [entryId], references: [id], onDelete: Cascade)
  version     Int
  sleepTenths Int?
  rest        RestPerception?
  fatigue     FatiguePerception?
  recovery    RecoveryPerception?
  notes       String?
  fingerprint String
  recordedAt  DateTime           @default(now())

  @@unique([entryId, version])
}

model SleepSharing {
  athleteId     String   @id
  athlete       Athlete  @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  coachId       String
  coach         User     @relation(fields: [coachId], references: [id], onDelete: Cascade)
  birthDate     DateTime @db.Date
  noticeVersion String
  noticeDigest  String
  grantedAt     DateTime @default(now())
  revokedAt     DateTime?

  @@index([coachId])
}

enum PreventiveSurveyKind {
  INITIAL
  FINAL
  COACH
}

model PreventiveSurvey {
  id               String @id @default(uuid())
  athleteId        String
  programId        String
  respondentId     String
  startedOn        DateTime @db.Date
  kind             PreventiveSurveyKind
  catalogue        Json
  catalogueVersion String
  sportContext     Json
  version          Int @default(1)
  submittedAt      DateTime?
  athlete          Athlete @relation(fields: [athleteId], references: [id], onDelete: Restrict)
  program          Program @relation(fields: [programId], references: [id], onDelete: Restrict)
  respondent       User @relation(fields: [respondentId], references: [id], onDelete: Restrict)
  revisions        PreventiveSurveyRevision[]

  @@unique([athleteId, programId, startedOn, kind, respondentId])
  @@index([respondentId, startedOn])
}

model PreventiveSurveyRevision {
  surveyId    String
  version     Int
  operationId String @unique
  fingerprint String
  actorId     String
  answers     Json
  recordedAt  DateTime @default(now())
  survey      PreventiveSurvey @relation(fields: [surveyId], references: [id], onDelete: Restrict)
  actor       User @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@id([surveyId, version])
}

model PreventiveSurveyConsent {
  athleteId   String @id
  version     String
  text        String
  acceptedAt  DateTime @default(now())
  revokedAt   DateTime?
  athlete     Athlete @relation(fields: [athleteId], references: [id], onDelete: Restrict)
}
