# Copia este archivo a .env y ajusta los valores
PORT=3000
DATABASE_URL="postgresql://luchasegura:luchasegura@localhost:5432/luchasegura?schema=public"
JWT_SECRET="cambia-esto-por-un-valor-largo-y-aleatorio"
JWT_EXPIRES_IN="2h"
CORS_ORIGIN="http://localhost:4200"
# Activa solo detrás de un número fijo de proxies controlados que saneen X-Forwarded-For.
TRUST_PROXY_HOPS=0

# Cambia a smtp después de completar los valores SMTP en tu archivo local.
MAIL_TRANSPORT=disabled
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
FRONTEND_PUBLIC_URL=http://localhost:4200
